{
  "_note": "Fixed spoken phrases and the action each must produce. The Dart parser must pass every case. Speech recognition gives lower-case text without punctuation; numbers may arrive as digits or words ('twenty'). 'apps' come from apps.json.",
  "defaults": {"volume_step": 5},
  "cases": [
    {"say": "open netflix",              "do": {"type": "app", "id": "netflix"}},
    {"say": "launch youtube",            "do": {"type": "app", "id": "youtube"}},
    {"say": "start prime video",         "do": {"type": "app", "id": "prime"}},
    {"say": "go to hotstar",             "do": {"type": "app", "id": "hotstar"}},
    {"say": "play spotify",              "do": {"type": "app", "id": "spotify"}},
    {"say": "zee five",                  "do": {"type": "app", "id": "zee5"}},
    {"say": "open sony liv",             "do": {"type": "app", "id": "sonyliv"}},
    {"say": "volume up",                 "do": {"type": "volume_delta", "delta": 5}},
    {"say": "volume down",               "do": {"type": "volume_delta", "delta": -5}},
    {"say": "louder",                    "do": {"type": "volume_delta", "delta": 5}},
    {"say": "quieter",                   "do": {"type": "volume_delta", "delta": -5}},
    {"say": "turn the volume up by 10",  "do": {"type": "volume_delta", "delta": 10}},
    {"say": "decrease volume by 3",      "do": {"type": "volume_delta", "delta": -3}},
    {"say": "set volume to 30",          "do": {"type": "volume_set", "level": 30}},
    {"say": "volume 45",                 "do": {"type": "volume_set", "level": 45}},
    {"say": "volume twenty",             "do": {"type": "volume_set", "level": 20}},
    {"say": "maximum volume",            "do": {"type": "volume_set", "level": 100}},
    {"say": "mute",                      "do": {"type": "mute", "on": true}},
    {"say": "unmute",                    "do": {"type": "mute", "on": false}},
    {"say": "sound on",                  "do": {"type": "mute", "on": false}},
    {"say": "pause",                     "do": {"type": "key", "key": "PAUSE"}},
    {"say": "resume",                    "do": {"type": "key", "key": "PLAY"}},
    {"say": "play",                      "do": {"type": "key", "key": "PLAY"}},
    {"say": "stop",                      "do": {"type": "key", "key": "STOP"}},
    {"say": "next",                      "do": {"type": "key", "key": "NEXT"}},
    {"say": "previous",                  "do": {"type": "key", "key": "PREVIOUS"}},
    {"say": "rewind",                    "do": {"type": "key", "key": "REWIND"}},
    {"say": "fast forward",              "do": {"type": "key", "key": "FAST_FORWARD"}},
    {"say": "go back",                   "do": {"type": "key", "key": "BACK"}},
    {"say": "home",                      "do": {"type": "key", "key": "HOME"}},
    {"say": "go home",                   "do": {"type": "key", "key": "HOME"}},
    {"say": "up",                        "do": {"type": "key", "key": "UP"}},
    {"say": "down",                      "do": {"type": "key", "key": "DOWN"}},
    {"say": "left",                      "do": {"type": "key", "key": "LEFT"}},
    {"say": "right",                     "do": {"type": "key", "key": "RIGHT"}},
    {"say": "select",                    "do": {"type": "key", "key": "CENTER"}},
    {"say": "ok",                        "do": {"type": "key", "key": "CENTER"}},
    {"say": "turn off the tv",           "do": {"type": "key", "key": "POWER"}},
    {"say": "switch off",                "do": {"type": "key", "key": "POWER"}},
    {"say": "tell me a joke",            "do": {"type": "unknown"}},
    {"say": "open",                      "do": {"type": "unknown"}},
    {"say": "open something else",       "do": {"type": "unknown"}}
  ]
}
